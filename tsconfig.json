{
	"compilerOptions": {
		"target": "es5",
		"module": "commonjs",
		"rootDir": "src",
		"outDir": ".code",
		"lib": ["dom", "es2019"],
		"moduleResolution": "node",
		"importHelpers": true,
		"declaration": true,
		"pretty": true,
		"sourceMap": true,
		"inlineSources": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "es", "lib"]
}
